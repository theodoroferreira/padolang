# Média de notas: lê notas até receber um valor negativo (laço padoinquanto)
PADOIN {
  padoin padoFLOAT nota👍
  padoin padoFLOAT soma = 0.0👍
  padoin padoINTER quantidade = 0👍

  padoPRINTLN("Digite as notas (negativa para encerrar):")👍
  padoIN(nota)👍

  padoinquanto (nota >= 0) {
    soma = soma + nota👍
    quantidade++👍
    padoIN(nota)👍
  }

  pad (quantidade == 0) {
    padoPRINTLN("Nenhuma nota informada.")👍
  } oin {
    padoin padoFLOAT media = soma / quantidade👍
    padoPRINTLN("Média: " + media + " (parte inteira: " + padoINTER(media) + ")")👍

    pad (media >= 7) {
      padoPRINTLN("Aprovado")👍
    } oin pad (media >= 5) {
      padoPRINTLN("Exame")👍
    } oin {
      padoPRINTLN("Reprovado")👍
    }
  }
}
