# Textos, concatenação, valores lógicos e uma função que devolve padoSTRING
padUNCTION padoSTRING cumprimento(padoINTER hora) {
  pad (hora < 12) {
    padOUT "Bom dia"👍
  } oin pad (hora < 18) {
    padOUT "Boa tarde"👍
  }
  padOUT "Boa noite"👍
}

PADOIN {
  padoin padoSTRING nome👍
  padoin padoINTER hora👍

  padoPRINT("Seu nome: ")👍
  padoIN(nome)👍
  padoPRINT("Que horas são (0 a 23)? ")👍
  padoIN(hora)👍
  padoPRINTLN()👍

  pad (hora < 0 padOR hora > 23) {
    padoPRINTLN("Hora inválida: " + hora)👍
  } oin {
    # comparação de textos compara o conteúdo (vira strcmp no C)
    padoin padoOLEAN conhecido = nome == "Padoin"👍
    padoPRINTLN(cumprimento(hora) + ", " + nome + "!")👍
    pad (conhecido) {
      padoPRINTLN("Já te conheço!")👍
    }
    padoPRINTLN("conhecido = " + conhecido)👍
  }
}
