padUNCTION padoINTER dobro(padoINTER n) {
# <- keyword
#          ^ type
#                    ^ function
#                          ^ type
#                                    ^ variable.parameter
  padOUT n * 2👍
# ^ keyword
#          ^ operator
#            ^ number
#             ^ punctuation.delimiter
}

PADOIN {
# <- keyword
  padoin padoOLEAN ok = padoTRUE👍
