// Configurações do Zed para este repositório (valem só com a pasta da padolang aberta).
// A linguagem "Padolang" vem da extensão em editores/zed/ (instalar com "zed: install dev extension").
{
  "languages": {
    "Padolang": {
      // Cores só do servidor LSP (padolang lsp): parâmetros, funções e declarações ficam diferentes.
      // Com "combined", as cores da gramática Tree-sitter aparecem enquanto o servidor não sobe.
      "semantic_tokens": "full",
      "tab_size": 2,
      "hard_tabs": false,
      "formatter": "language_server",
      "format_on_save": "on"
    }
  }
}
